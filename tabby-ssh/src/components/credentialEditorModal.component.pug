div.modal-body
    h5.modal-title.mb-3(translate) Credential

    .form-group
        label(translate) Name
        input.form-control(type='text', [(ngModel)]='credential.name', placeholder='Credential name')

    .form-group
        label(translate) Username
        input.form-control(type='text', [(ngModel)]='credential.username', placeholder='root')

    .form-group
        label(translate) Private keys
        .mb-2(*ngFor='let key of credential.privateKeys')
            .d-flex.align-items-center
                input.form-control.form-control-sm.me-2([readonly]='true', [value]='key')
                .action((click)='removePrivateKey(key)')
                    i.fas.fa-trash
        button.btn.btn-sm.btn-secondary((click)='addPrivateKey()')
            i.fas.fa-plus.me-1
            span(translate) Add private key

    .form-group
        label(translate) Password
        .d-flex.align-items-center
            span.me-auto.text-muted(*ngIf='!hasSavedPassword', translate) Not set
            span.me-auto.text-success(*ngIf='hasSavedPassword', translate) Saved
            button.btn.btn-sm.btn-secondary((click)='setPassword()', *ngIf='!hasSavedPassword', translate) Set password
            button.btn.btn-sm.btn-warning((click)='clearPassword()', *ngIf='hasSavedPassword', translate) Clear password

div.modal-footer
    button.btn.btn-primary((click)='save()', [disabled]='!credential.name?.trim()', translate) Save
    button.btn.btn-secondary((click)='cancel()', translate) Cancel
